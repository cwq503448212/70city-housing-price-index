  "model": {
    "horizon": "2055",
    "calibrationYears": 5,
    "stages": {
      "primary": {
        "label": "小学",
        "years": 6,
        "entryAge": 6,
        "admit": "admit_primary",
        "enroll": "enroll_primary",
        "graduate": "grad_primary",
        "weights": [1, 1, 1, 1, 1, 1],
        "upstream": "birth",
        "lag": 6
      },
      "junior": {
        "label": "初中",
        "years": 3,
        "entryAge": 12,
        "admit": "admit_junior",
        "enroll": "enroll_junior",
        "graduate": "grad_junior",
        "weights": [1, 1, 1],
        "upstream": "primary",
        "lag": 6
      },
      "senior": {
        "label": "普通高中",
        "years": 3,
        "entryAge": 15,
        "admit": "admit_senior",
        "enroll": "enroll_senior",
        "graduate": "grad_senior",
        "weights": [1, 1, 1],
        "upstream": "junior",
        "lag": 3
      },
      "college": {
        "label": "本专科",
        "years": 4,
        "entryAge": 18,
        "admit": "admit_college",
        "enroll": "enroll_college",
        "graduate": "grad_college",
        "weights": [1, 1, 1, 0.75],
        "upstream": "senior",
        "lag": 3
      }
    },
    "housing": {
      "buyerAgeFrom": 25,
      "buyerAgeTo": 44,
      "survival": 0.98,
      "baseYears": 3,
      "intensityTau": 8,
      "note": "25—44 岁按出生队列逐年移位；存活率 0.98 是模型参数，不是官方统计值"
    },
    "scenarios": {
      "low": {
        "label": "低情景",
        "birthGrowth": -0.03,
        "houseIntensity": 0.85,
        "priceGrowth": -0.02
      },
      "base": {
        "label": "基准情景",
        "birthGrowth": -0.01,
        "houseIntensity": 1,
        "priceGrowth": 0
      },
      "high": {
        "label": "高情景",
        "birthGrowth": 0,
        "houseIntensity": 1.15,
        "priceGrowth": 0.02
      }
    },
    "backtest": {
      "calibrateFrom": "2015",
      "calibrateTo": "2019",
      "from": "2020",
      "to": "2025"
    },
    "notes": [
      "出生人口未来值 = 最新一年官方出生人口 × (1 + 年增速)^年数，三种情景只改年增速",
      "各学段招生 = 上游队列 × 近 5 年招生传导系数（出生 → 小学 → 初中 → 普高 → 本专科）",
      "在校生 = 最近 N 年招生按学制加总（本专科按 [1,1,1,0.75] 近似 3 年制与 4 年制混合）",
      "购房主力人口 = 25—44 岁出生队列 × 0.98 存活率；销售面积 = 购房主力人口 × 人均购房强度，强度按情景向目标值指数收敛",
      "商品房均价按名义年增速做情景外推，不扣通胀、不建模供需，只给区间参考"
    ]
  }
