  "history": {
    "from": "1990",
    "note": "社会保险基金与参保人数系列在年度库里从 1990 年起；城乡居民基本养老保险自 2010 年（新农保试点）、领取待遇人数自 2012 年起；基本医疗保险基金自 2015 年、全口径参保人数自 2017 年起。起点之前的空值就是官方没有这条数据，缺失就是缺失，不补数"
  },
  "groups": [
    {
      "key": "fund",
      "label": "五险基金收支结余",
      "note": "官方发布的 18 项：合计 + 养老 / 医保 / 失业 / 工伤 / 生育 各「基金收入、基金支出、年末累计结余」。收入支出是当年流量（亿元 / 年），累计结余是年末存量（亿元），两者不能混在一条曲线上比较；当期结余（收入 − 支出）是本页计算值"
    },
    {
      "key": "pension",
      "label": "职工养老",
      "note": "城镇职工基本养老保险：年末参保人数含在职职工与离退休人员两部分；基金三项见「五险基金」组"
    },
    {
      "key": "resident",
      "label": "城乡居民养老",
      "note": "城乡居民基本养老保险（2014 年由新农保与城镇居民养老保险合并）：参保人数、实际领取待遇人数与基金三项"
    },
    {
      "key": "medical",
      "label": "基本医疗保险",
      "note": "基本医保的 14 项：参保人数 5 项（合计 / 职工 / 在岗职工 / 退休人员 / 城乡居民）、基金收入 3 项、基金支出 3 项、累计结余 3 项（职工与居民的合计三项在「五险基金」组，同一批数只保留一条序列）"
    },
    {
      "key": "unemployment",
      "label": "失业保险",
      "note": "参保人数与年末领取失业保险金人数；基金三项见「五险基金」组"
    },
    {
      "key": "injury",
      "label": "工伤保险",
      "note": "参保人数与享受工伤保险待遇人数（按人统计，不是人次）；基金三项见「五险基金」组"
    },
    {
      "key": "maternity",
      "label": "生育保险",
      "note": "参保人数与享受生育保险待遇人数；基金三项官方止于 2018 年（2019 年起并入职工基本医疗保险基金统一征缴、统一管理，不再单列），已归档不再核对"
    },
    {
      "key": "denominator",
      "label": "参保率分母",
      "note": "参保率是本页计算值，分母只用官方发布的口径：城镇就业人员（职工养老在职 / 失业 / 工伤 / 生育）与年末总人口（基本医保）。分母本身也一并列出，方便核对"
    }
  ],
