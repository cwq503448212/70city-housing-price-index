{
  "name": "china-economic-stats-dashboard",
  "version": "2.0.0",
  "private": true,
  "description": "中国经济统计数据看板：70 个大中城市房价指数 + 宏观经济指标（CPI / PPI / PMI / 社零 / M2），数据来自国家统计局",
  "author": "cwq503448212 <503448212@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cwq503448212/china-economic-stats-dashboard.git"
  },
  "homepage": "https://github.com/cwq503448212/china-economic-stats-dashboard#readme",
  "bugs": {
    "url": "https://github.com/cwq503448212/china-economic-stats-dashboard/issues"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "probe": "node probe.js",
    "data:build": "node -e \"console.log(require('./lib/housing/nbs70').publishDataset())\"",
    "data:raw": "node -e \"require('./lib/housing/nbs70').backfillRaw({}).then(function(r){console.log(r)})\""
  },
  "keywords": ["国家统计局", "70城房价", "宏观经济", "CPI", "PPI", "PMI", "数据可视化"],
  "engines": {
    "node": ">=20"
  }
}
