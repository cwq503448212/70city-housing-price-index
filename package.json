{
  "name": "china-economic-stats-dashboard",
  "version": "3.4.0",
  "private": true,
  "description": "中国经济统计数据看板：70 个大中城市房价指数 + 宏观经济指标（CPI / PPI / PMI / 社零 / M2）+ 房贷利率 LPR + 婚育与人口出生（结婚 / 离婚登记、初婚人数、出生率）+ 人均收入与支出（可支配收入、四项收入分项、八项消费分项、城乡对比）+ 居民存款与人均存款（住户存款余额、当月新增、活期 / 定期结构、人均存款）+ 社会消费品零售（总量当月 / 累计与同比、餐饮 / 商品零售、城镇 / 乡村、网上零售、剔除汽车、限额以上重点品类），数据来自国家统计局、中国人民银行与中国货币网",
  "author": "cwq503448212 <503448212@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cwq503448212/china-economic-stats-dashboard.git"
  },
  "homepage": "https://github.com/cwq503448212/china-economic-stats-dashboard#readme",
  "bugs": {
    "url": "https://github.com/cwq503448212/china-economic-stats-dashboard/issues"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "probe": "node probe.js",
    "data:build": "node -e \"console.log(require('./lib/housing/nbs70').publishDataset())\"",
    "data:raw": "node -e \"require('./lib/housing/nbs70').backfillRaw({}).then(function(r){console.log(r)})\""
  },
  "keywords": ["国家统计局", "70城房价", "宏观经济", "CPI", "PPI", "PMI", "LPR", "贷款市场报价利率", "中国货币网", "人均可支配收入", "消费支出", "住户存款", "人均存款", "社会消费品零售", "社零", "网上零售", "数据可视化"],
  "engines": {
    "node": ">=20"
  }
}
